# Load these into the process environment; Spring does not load .env files automatically.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/gymfit?connectionTimeZone=UTC
DB_USERNAME=gymfit
DB_PASSWORD=
USDA_API_KEY=
SPOONACULAR_API_KEY=
SPOONACULAR_ENABLED=false
FRONTEND_ORIGIN=http://localhost:5173
REPORTING_TIME_ZONE=Asia/Kolkata
# Production: omit the local profile and configure a real OIDC provider.
JWT_ISSUER_URI=
JWT_AUDIENCE=gymfit
